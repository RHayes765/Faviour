# Copy to .env and fill in from Supabase → Project Settings → API.
# The anon key is public-by-design (RLS is the security boundary), but keep
# .env out of the public repo to avoid free-tier quota abuse.
# NEVER put the service_role key here or anywhere else in this project.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
